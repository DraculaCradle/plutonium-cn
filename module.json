      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "cn",
      "name": "简体中文",
      "path": "lang/cn.json"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.6",
